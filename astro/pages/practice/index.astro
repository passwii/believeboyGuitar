---
import { Icon } from "@/components/icons";
import { practiceEntries } from "@/content/manifest";
import { practiceSections } from "@/lib/practice-sections";
import { latestPracticeEntry, practiceHref } from "@/lib/practice";
import BaseLayout from "@/astro/layouts/BaseLayout.astro";

const latest = latestPracticeEntry(practiceEntries);
const entries = practiceEntries.map((entry, entryIndex) => ({
  ...entry,
  number: String(entryIndex + 1).padStart(2, "0"),
  sections: practiceSections(entry.slug),
  href: practiceHref(entry),
}));
---
<BaseLayout title="练习">
  <main class="shell flex-1 py-8 sm:py-12">
    <header class="flex flex-wrap items-end justify-between gap-5">
      <div>
        <p class="text-micro font-medium uppercase text-ink-500">Practice</p>
        <h1 class="mt-2 text-display font-display text-ink-950">练习</h1>
        <p class="mt-2 text-body text-ink-700">按谱练习，每次只推进一段。</p>
      </div>
      {latest && (
        <a
          href={practiceHref(latest)}
          class="inline-flex min-h-11 items-center gap-2 rounded-control bg-accent-700 px-4 text-label font-semibold text-on-accent"
        >
          继续 {latest.label ?? latest.title}
          <Icon name="chevron-right" className="size-3.5" />
        </a>
      )}
    </header>

    <ol class="mt-8 border-t border-rule">
      {entries.map((entry) => (
        <li class="border-b border-rule">
          <a href={entry.href} class="practice-entry-row">
            <span class="practice-entry-row__number">{entry.number}</span>
            <span>
              <strong>{entry.label ? entry.label + " · " : ""}{entry.title}</strong>
              <small>{entry.sections.length} 段谱例 · {entry.focus}</small>
            </span>
            <Icon name="chevron-right" className="size-4 text-ink-300" />
          </a>
        </li>
      ))}
    </ol>
  </main>
</BaseLayout>
