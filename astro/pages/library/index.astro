---
import { libraryEntries } from "@/content/manifest";
import BaseLayout from "@/astro/layouts/BaseLayout.astro";

const entries = libraryEntries.map((entry) => ({
  ...entry,
  scalePaths: [1, 2, 3, 4, 5, 6],
}));
---
<BaseLayout title="资料库">
  <main class="shell flex-1 py-8 sm:py-12">
    <header class="border-b border-rule pb-5">
      <p class="text-micro font-medium uppercase text-ink-500">Library</p>
      <h1 class="mt-2 text-display font-display text-ink-950">资料库</h1>
      <p class="mt-2 font-mono text-meta text-ink-500">
        {String(libraryEntries.length).padStart(2, "0")} MATERIAL
      </p>
    </header>

    <ul>
      {entries.map((entry) => (
        <li class="border-b border-rule">
          <a href={entry.href} class="library-material-row">
            <span>
              <strong>{entry.title}</strong>
              <small>{entry.meta}</small>
            </span>
            <span class="library-color-strip" aria-hidden="true">
              {entry.scalePaths.map((id) => <i class={"scale-color-" + id}></i>)}
            </span>
          </a>
        </li>
      ))}
    </ul>
  </main>
</BaseLayout>
