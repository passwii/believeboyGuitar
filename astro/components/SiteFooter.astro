---
interface Props {
  pathname: string;
}

const { pathname } = Astro.props;
const focusMode =
  pathname === "/metronome" ||
  pathname.startsWith("/practice/") ||
  pathname === "/library/fretboard-scale";
---
<footer
  class:list={[
    focusMode && "hidden sm:block",
    "mt-auto pb-[calc(var(--dock-h)+1.5rem+env(safe-area-inset-bottom))] sm:pb-[max(2.5rem,env(safe-area-inset-bottom))]",
  ]}
>
  <div class="shell">
    <div class="border-t border-rule pt-6 text-meta text-ink-500">
      个人练习站 · TAB / 音阶 / 节拍器
    </div>
  </div>
</footer>
