---
import { Icon, type IconName } from "@/components/icons";

interface Props {
  pathname: string;
}

const { pathname } = Astro.props;

type NavItem = {
  href: string;
  label: string;
  icon: IconName;
  match: (path: string) => boolean;
};

const NAV_ITEMS: readonly NavItem[] = [
  { href: "/", label: "首页", icon: "home", match: (path) => path === "/" },
  {
    href: "/practice",
    label: "练习",
    icon: "repeat",
    match: (path) => path === "/practice" || path.startsWith("/practice/"),
  },
  {
    href: "/library",
    label: "资料库",
    icon: "library",
    match: (path) => path === "/library" || path.startsWith("/library/"),
  },
  {
    href: "/metronome",
    label: "节拍器",
    icon: "metronome",
    match: (path) => path === "/metronome",
  },
];

const items = NAV_ITEMS.map((item) => ({ ...item, active: item.match(pathname) }));
const focusMode = pathname === "/metronome" || pathname.startsWith("/practice/week-");
---
<header
  class:list={[
    focusMode && "hidden sm:block",
    "sticky top-0 z-30 border-b border-rule bg-canvas/78 backdrop-blur-xl backdrop-saturate-150 supports-[not(backdrop-filter:blur(0))]:bg-canvas",
  ]}
>
  <div class="shell shell-nav pt-[env(safe-area-inset-top)]">
    <a
      href="/"
      aria-label="练习站首页"
      class="flex min-h-11 items-center gap-2.5 text-label font-semibold tracking-tight text-ink-950"
    >
      <span
        aria-hidden="true"
        class="flex size-7 flex-none items-end justify-center gap-[3px] rounded-control bg-accent-700 px-[5px] py-1.5"
      >
        <span class="h-2 w-1 rounded-full bg-on-accent"></span>
        <span class="h-3.5 w-1 rounded-full bg-on-accent"></span>
        <span class="h-1.5 w-1 rounded-full bg-on-accent"></span>
      </span>
      练习站
    </a>

    <nav aria-label="主导航" class="hidden sm:block">
      <ul class="flex items-center gap-1">
        {items.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={item.active ? "page" : undefined}
              class:list={[
                "flex min-h-11 items-center gap-1.5 rounded-control px-3 text-label transition-colors duration-150",
                item.active ? "bg-surface-muted font-semibold text-ink-950" : "text-ink-700 hover:text-ink-950",
              ]}
            >
              <Icon
                name={item.icon}
                className={item.active ? "size-4 text-accent-700" : "size-4 text-ink-500"}
              />
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<nav
  aria-label="移动端导航"
  class:list={[
    focusMode && "hidden",
    "fixed inset-x-0 bottom-0 z-40 border-t border-rule bg-canvas/92 backdrop-blur-xl backdrop-saturate-150 supports-[not(backdrop-filter:blur(0))]:bg-canvas sm:hidden",
  ]}
>
  <ul class="grid grid-cols-4 pb-[env(safe-area-inset-bottom)]">
    {items.map((item) => (
      <li>
        <a
          href={item.href}
          aria-current={item.active ? "page" : undefined}
          class:list={[
            "flex min-h-[var(--dock-h)] flex-col items-center justify-center gap-0.5 px-1 text-meta transition-colors duration-150",
            item.active ? "font-semibold text-ink-950" : "text-ink-500 hover:text-ink-950",
          ]}
        >
          <Icon
            name={item.icon}
            className={item.active ? "size-5 text-accent-700" : "size-5 text-ink-500"}
          />
          {item.label}
        </a>
      </li>
    ))}
  </ul>
</nav>
