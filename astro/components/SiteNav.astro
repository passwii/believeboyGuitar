---
import { Icon, type IconName } from "@/components/icons";

interface Props {
  pathname: string;
}

const { pathname } = Astro.props;

type NavItem = {
  href: string;
  label: string;
  icon: IconName;
  match: (path: string) => boolean;
};

const NAV_ITEMS: readonly NavItem[] = [
  { href: "/", label: "首页", icon: "home", match: (path) => path === "/" },
  {
    href: "/practice",
    label: "练习",
    icon: "repeat",
    match: (path) => path === "/practice" || path.startsWith("/practice/"),
  },
  {
    href: "/library",
    label: "资料库",
    icon: "library",
    match: (path) => path === "/library" || path.startsWith("/library/"),
  },
  {
    href: "/metronome",
    label: "节拍器",
    icon: "metronome",
    match: (path) => path === "/metronome",
  },
];

const items = NAV_ITEMS.map((item) => ({ ...item, active: item.match(pathname) }));
const focusMode = pathname === "/metronome" || pathname.startsWith("/practice/week-");
---
<header
  class:list={[
    focusMode && "hidden sm:block",
    "shell-nav-glass",
  ]}
>
  <div class="shell shell-nav pt-[env(safe-area-inset-top)]">
    <a
      href="/"
      aria-label="练习站首页"
      class="flex min-h-11 items-center gap-2.5 text-label font-semibold tracking-tight text-ink-950"
    >
      <span
        aria-hidden="true"
        class="flex size-7 flex-none items-end justify-center gap-[3px] rounded-control bg-accent-700 px-[5px] py-1.5 shadow-[0_0_12px_var(--color-accent-glow)] transition-shadow duration-200"
      >
        <span class="h-2 w-1 rounded-full bg-on-accent"></span>
        <span class="h-3.5 w-1 rounded-full bg-on-accent"></span>
        <span class="h-1.5 w-1 rounded-full bg-on-accent"></span>
      </span>
      练习站
    </a>

    <div class="flex items-center gap-2">
      <nav aria-label="主导航" class="hidden sm:block">
        <ul class="flex items-center gap-1">
          {items.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={item.active ? "page" : undefined}
                class:list={[
                  "flex min-h-11 items-center gap-1.5 rounded-control px-3 text-label transition-all duration-150 active:scale-[0.98]",
                  item.active
                    ? "bg-surface-elevated font-semibold text-ink-950 shadow-sm border border-glass-border"
                    : "text-ink-700 hover:text-ink-950 hover:bg-surface-muted/60",
                ]}
              >
                <Icon
                  name={item.icon}
                  className={item.active ? "size-4 text-accent-700" : "size-4 text-ink-500"}
                />
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <button
        id="theme-toggle"
        type="button"
        aria-label="切换明暗色彩"
        title="切换明暗色彩"
        class="flex min-h-11 min-w-11 items-center justify-center rounded-control border border-glass-border bg-surface-glass text-ink-700 transition-all duration-150 hover:bg-surface-elevated hover:text-ink-950 active:scale-95"
      >
        <span class="flex items-center justify-center dark:hidden">
          <Icon name="moon" className="size-4 text-ink-700" />
        </span>
        <span class="hidden items-center justify-center dark:flex">
          <Icon name="sun" className="size-4 text-ink-700" />
        </span>
      </button>
    </div>
  </div>
</header>

<nav
  aria-label="移动端导航"
  class:list={[
    focusMode && "hidden",
    "dock-glass sm:hidden",
  ]}
>
  <ul class="grid grid-cols-4 pb-[env(safe-area-inset-bottom)]">
    {items.map((item) => (
      <li>
        <a
          href={item.href}
          aria-current={item.active ? "page" : undefined}
          class:list={[
            "flex min-h-[var(--dock-h)] flex-col items-center justify-center gap-0.5 px-1 text-meta transition-all duration-150 active:scale-95",
            item.active ? "font-semibold text-ink-950" : "text-ink-500 hover:text-ink-950",
          ]}
        >
          <Icon
            name={item.icon}
            className={item.active ? "size-5 text-accent-700" : "size-5 text-ink-500"}
          />
          {item.label}
        </a>
      </li>
    ))}
  </ul>
</nav>

<script is:inline>
  (function () {
    function initThemeToggle() {
      var btn = document.getElementById("theme-toggle");
      if (!btn) return;
      btn.onclick = function () {
        var current = document.documentElement.getAttribute("data-theme") || "dark";
        var next = current === "dark" ? "light" : "dark";
        document.documentElement.setAttribute("data-theme", next);
        try {
          localStorage.setItem("theme", next);
        } catch (_) {}
        var meta = document.querySelector('meta[name="theme-color"]');
        if (meta) {
          meta.setAttribute("content", next === "dark" ? "#0a0d12" : "#f4f6fa");
        }
      };
    }
    initThemeToggle();
    document.addEventListener("astro:after-swap", initThemeToggle);
  })();
</script>
