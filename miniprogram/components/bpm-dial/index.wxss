.dial-shell {
  position: relative;
  width: 100%;
  max-width: 560rpx;
  min-width: 44px;
  min-height: 44px;
  aspect-ratio: 1;
  margin: 0 auto;
  touch-action: none;
}

.dial {
  position: absolute;
  inset: 0;
  display: block;
  width: 100%;
  height: 100%;
}

.dial__readout {
  position: absolute;
  inset: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  pointer-events: none;
}

.dial__bpm {
  color: var(--color-ink-950);
  font-size: 112rpx;
  font-variant-numeric: tabular-nums;
  font-weight: 600;
  line-height: 1.1;
}

.dial__tempo {
  margin-top: 8rpx;
  color: var(--color-ink-500);
  font-size: 28rpx;
}
