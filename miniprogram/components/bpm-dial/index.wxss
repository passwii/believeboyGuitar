.dial-shell {
  position: relative;
  width: 100%;
  max-width: 560rpx;
  min-width: 44px;
  min-height: 44px;
  margin: 0 auto;
  touch-action: none;
}

.dial__ratio {
  width: 100%;
  padding-top: 100%;
}

.dial {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: block;
  width: 100%;
  height: 100%;
}

.dial__readout {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  pointer-events: none;
}

.dial__bpm {
  color: var(--color-ink-950);
  font-size: 112rpx;
  font-variant-numeric: tabular-nums;
  font-weight: 600;
  line-height: 1.1;
}

.dial__tempo {
  margin-top: 8rpx;
  color: var(--color-ink-500);
  font-size: 28rpx;
}
